# App
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# CRM Integration Service (Fase 8 — preencher quando a API do CRM estiver definida)
CRM_API_URL=
CRM_API_KEY=

# Lead Research Service (Fase 7 — preencher quando uma API de pesquisa externa for conectada)
LEAD_RESEARCH_API_URL=
LEAD_RESEARCH_API_KEY=
